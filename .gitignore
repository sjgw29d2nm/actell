# Local diagnostics can include device identifiers, network details and host paths.
# Keep reviewed conclusions in Markdown; retain raw output locally, outside Git.
*.log
*.log.*
*.xcactivitylog
*.xcresult/
*.trace/
*.pcap
*.pcapng
/attachments/
/logs/
/diagnostics/

# Generated validation output and machine-specific session inventories.
/docs/**/evidence/
/docs/local-validation/*
!/docs/local-validation/*.md
/docs/integration/*.json
/docs/usb-device/baseline.json
/ios-app/docs/xcode-validation/
/ios-app/docs/background-runs/validation.txt
/ios-app/docs/siri-validation/*.json

# Isolated NCM/CoreDevice experiment; diagnostic bytes and build outputs stay local.
/ncm-dev/firmware/managed_components/
/ncm-dev/firmware/sdkconfig*
!/ncm-dev/firmware/sdkconfig.defaults
/ncm-dev/firmware/build/
/ncm-dev/PhoneAgentNCM/.build/
/ncm-dev/PhoneAgentNCM/.swiftpm/
/ncm-dev/**/pairing*.plist
/ncm-dev/**/identity*.plist
/ncm-dev/**/screen*.png
/ncm-dev/**/screen*.hevc
/ncm-dev/rust/target/

# Keep captured screens and their manifests local; retain app assets and test fixtures.
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/ios-app/docs/**/*.png
/ios-app/docs/**/*.jpg
/archives/history/**/*.png
/archives/history/**/*.jpg
